# Ajith P C - Portfolio Environment Configuration
# ===================================================================
# TODO: Choose either EmailJS or Formspree for the Contact form,
# or leave these empty to use the built-in interactive simulated sender.

# Option 1: EmailJS Configuration (Recommended for direct client sending)
# Sign up free at https://www.emailjs.com/
# 1. Create an Email Service (e.g. Gmail) -> get Service ID
# 2. Create an Email Template -> get Template ID
# 3. Go to Account -> API Keys -> get Public Key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Option 2: Formspree Endpoint (Alternative simple form backend)
# Sign up at https://formspree.io/ -> create form -> copy endpoint URL
# Example: https://formspree.io/f/xvovdwwz
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here

